// Sustituir PRINCIPAL_ID por terraform -chdir=infra output -raw principal_id.
AzureDiagnostics
| where TimeGenerated > ago(3h)
| where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretGet"
| where identity_claim_oid_g == "PRINCIPAL_ID"
| project TimeGenerated, OperationName, ResultType, identity_claim_oid_g, identity_claim_xms_mirid_s, CallerIPAddress, requestUri_s
| order by TimeGenerated asc

// Ejecutar por separado para el historial de autoscale.
AutoscaleScaleActionsLog
| order by TimeGenerated asc
