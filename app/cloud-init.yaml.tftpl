#cloud-config
package_update: false
package_upgrade: false
users:
  - default
  - name: caribeshop
    system: true
    shell: /usr/sbin/nologin
write_files:
  - path: /opt/caribeshop/server.py
    permissions: '0644'
    content: |
      ${indent(6, app_source)}
  - path: /etc/systemd/system/caribeshop.service
    permissions: '0644'
    content: |
      [Unit]
      Description=CaribeShop lab
      After=network-online.target
      Wants=network-online.target

      [Service]
      User=caribeshop
      Group=caribeshop
      ExecStart=/usr/bin/python3 /opt/caribeshop/server.py
      Environment=KEY_VAULT_URL=${vault_url}
      Restart=always
      RestartSec=3
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      TasksMax=256

      [Install]
      WantedBy=multi-user.target
runcmd:
  - [mkdir, -p, /var/lib/caribeshop]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, caribeshop]
